# Server-side API connection
SOSTATS_API_URL=http://localhost:4000

# Production: provide a bearer token from the application auth/session layer.
SOSTATS_API_TOKEN=

# Local development only. These map to the API's AUTH_DEV_BYPASS headers.
SOSTATS_DEV_EMAIL=dev@sostats.local
SOSTATS_DEV_NAME=SoStats Dev
SOSTATS_DEV_AUTO_WORKSPACE=true
