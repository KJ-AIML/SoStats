# Shared
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=sostats
POSTGRES_PASSWORD=sostats_secret
POSTGRES_DB=sostats_db
DATABASE_URL=postgres://sostats:sostats_secret@localhost:5432/sostats_db
DB_POOL_SIZE=10

# API
PORT=4000
CORS_ORIGIN=http://localhost:3000
AUTH_DEV_BYPASS=true
AUTH_JWT_SECRET=replace-with-a-long-random-development-secret
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret
AI_SERVICE_URL=http://localhost:8000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Object storage
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minio_secret_password
MINIO_BUCKET=sostats-uploads
MINIO_ENDPOINT=http://localhost:9000

# AI service
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202601

# Mailpit
# UI: http://localhost:8025
# SMTP: localhost:1025
