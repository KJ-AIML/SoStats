# Shared
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=sostats
POSTGRES_PASSWORD=sostats_secret
POSTGRES_DB=sostats_db
DATABASE_URL=postgres://sostats:sostats_secret@localhost:5432/sostats_db
DB_POOL_SIZE=10

# API
PORT=4000
CORS_ORIGIN=http://localhost:3000
AUTH_DEV_BYPASS=true
AUTH_JWT_SECRET=replace-with-at-least-32-bytes-of-random-secret-material
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_REQUIRE_VERIFIED_EMAIL=true
ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret
AI_SERVICE_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000
OAUTH_CALLBACK_URL=http://localhost:4000/v1/channels/oauth/callback
OAUTH_STATE_SECRET=replace-with-at-least-32-bytes-of-random-oauth-state-secret
PUBLIC_API_URL=http://localhost:4000
WEBHOOK_PUBLIC_BASE_URL=http://localhost:4000
WORKSPACE_INVITE_TTL_HOURS=168
OUTBOX_LEASE_SECONDS=120
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_MS=5000
OUTBOX_DISPATCH_POLL_MS=5000
OUTBOX_CLAIM_LIMIT=100
OUTBOX_CONCURRENCY=10

# Internal API / worker trust boundary
WORKER_API_TOKEN=replace-with-an-independent-long-random-worker-token
SOSTATS_API_URL=http://localhost:4000
PUBLISH_DISPATCH_POLL_MS=15000
PUBLISH_DISPATCH_HORIZON_MS=120000
PUBLISH_CONCURRENCY=5
PUBLISH_MAX_ATTEMPTS=5

# Automation runtime
AUTOMATION_DISPATCH_POLL_MS=5000
AUTOMATION_CONCURRENCY=4
AUTOMATION_MAX_ATTEMPTS=5

# RSS automation triggers
RSS_TRIGGER_DISPATCH_POLL_MS=15000
RSS_TRIGGER_CONCURRENCY=3
RSS_TRIGGER_MAX_ATTEMPTS=4

# Analytics ingestion
ANALYTICS_DISPATCH_POLL_MS=60000
ANALYTICS_CONCURRENCY=4
ANALYTICS_MAX_ATTEMPTS=4

# Media processing
MEDIA_DISPATCH_POLL_MS=5000
MEDIA_CONCURRENCY=3
MEDIA_MAX_ATTEMPTS=4
MEDIA_PROCESSING_STALE_MS=900000
MEDIA_MAX_UPLOAD_BYTES=104857600

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Object storage
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minio_secret_password
MINIO_BUCKET=sostats-uploads
MINIO_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Optional when objects are deliberately public/CDN-backed.
S3_PUBLIC_BASE_URL=

# AI service
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
RAG_MIN_SIMILARITY=0.2
KNOWLEDGE_MAX_UPLOAD_BYTES=15728640
KNOWLEDGE_PROCESSING_STALE_MS=1200000
KNOWLEDGE_DISPATCH_POLL_MS=5000
KNOWLEDGE_CONCURRENCY=2
KNOWLEDGE_MAX_ATTEMPTS=4

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn Marketing APIs are versioned YYYYMM. Keep this explicit so
# deployments must intentionally upgrade before a version sunsets.
LINKEDIN_API_VERSION=202609
LINKEDIN_SCOPES=openid profile email w_member_social r_member_postAnalytics

# X (Twitter) OAuth 2.0 confidential web app
X_CLIENT_ID=
X_CLIENT_SECRET=
X_SCOPES=tweet.read tweet.write users.read offline.access

# Meta / Facebook Login for Facebook Pages + linked Instagram Professional accounts
META_APP_ID=
META_APP_SECRET=
# Keep Graph API version explicit and intentionally upgrade it.
META_GRAPH_API_VERSION=v26.0
META_FACEBOOK_SCOPES=pages_show_list pages_read_engagement pages_manage_posts read_insights
META_INSTAGRAM_SCOPES=pages_show_list pages_read_engagement instagram_basic instagram_content_publish instagram_manage_insights
# Meta fetches attached media from the signed/public URL during publishing.
# In production S3_ENDPOINT must be externally reachable over HTTPS, or set
# S3_PUBLIC_BASE_URL to an externally reachable object/CDN base.
 
# Mailpit
# UI: http://localhost:8025
# SMTP: localhost:1025
